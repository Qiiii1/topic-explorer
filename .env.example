# Optional local configuration. Copy to .env and use npm run start:env.
# Leave model and API key empty to configure the service in the webpage instead.
PORT=4178
TOPIC_AI_BASE_URL=https://api.deepseek.com
TOPIC_AI_MODEL=
TOPIC_AI_API_KEY=

# Public backend URL for the GitHub Pages build; never put a model API key here.
# In GitHub Actions, set the repository Actions variable with this name.
TOPIC_API_BASE_URL=
