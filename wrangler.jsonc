{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topic-explorer-api",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "TOPIC_AI_BASE_URL": "https://api.deepseek.com",
    "TOPIC_AI_MODEL": "deepseek-flash",
    "TOPIC_WEB_ORIGINS": "https://qiiii1.github.io"
  }
}
